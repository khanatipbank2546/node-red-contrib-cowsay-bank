    {
        "id": "71f419c9b08c7ac8",
        "type": "function",
        "z": "f6d16c647fe9b2e0",
        "name": "function 4",
        "func": "// 1. ดึงค่าสัตว์ที่คนใช้เลือกจากหน้า UI\nconst selectedAnimal = env.get(\"character\") || \"cow\";\n\n// 2. สร้างโครงสร้าง Options รอสแตนด์บายไว้\nlet options = {\n    text: String(msg.payload)\n};\n\n// 3. เงื่อนไขดักบั๊ก: ถ้าคนใช้เลือกวาฬ ให้พ่วง f: \"whale\" เข้าไปด้วย\n// แต่ถ้าเลือก cow (วัว) ให้ข้ามไปเลย ไม่ต้องพ่วง เพื่อปล่อยให้ระบบเสกวัวเริ่มต้นออกมาเองโดยไม่บั๊กครับ!\nif (selectedAnimal === \"whale\") {\n    options.f = \"whale\";\n}\n\n// 4. สั่งวาดภาพตาม Options ที่เซ็ตไว้\nmsg.payload = cowsay.say(options);\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [
            {
                "var": "cowsay",
                "module": "cowsay"
            }
        ],
        "x": 200,
        "y": 80,
        "wires": [
